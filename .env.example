# Copy to .env.local for development. Never commit real values.
# Only VITE_* variables reach the browser bundle, and everything in them is
# PUBLIC. Never put secrets here. All values are validated in src/config/env.ts.

# Base URL of your REST API. Leave empty while VITE_ENABLE_MOCKS=true.
VITE_API_URL=

# Serve the API from Mock Service Worker (src/mocks) instead of a real backend.
# Defaults to true when VITE_API_URL is empty and false once it is set.
VITE_ENABLE_MOCKS=

# Shown in the UI and the document title.
VITE_APP_NAME=Acme Admin
